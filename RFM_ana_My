      "source": [
        "from sklearn.cluster import KMeans\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. 執行 K-means 分群 (K=4)\n",
        "kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)\n",
        "nrfm['Cluster'] = kmeans.fit_predict(nrfm[['R', 'F', 'M']])\n",
        "\n",
        "# 將分群結果也加回未正規化的原始 RFM 資料中，以便後續分析真實特徵\n",
        "result_df['Cluster'] = nrfm['Cluster']\n",
        "\n",
        "# 2. 計算各群的特徵平均值 (使用原始數值計算更有商業意義)\n",
        "cluster_summary = result_df.groupby('Cluster').agg(\n",
        "    Customer_Count=('Customer', 'count'),\n",
        "    Avg_Recency=('R', 'mean'),\n",
        "    Avg_Frequency=('F', 'mean'),\n",
        "    Avg_Monetary=('M', 'mean')\n",
        ").reset_index()\n",
        "\n",
        "print(\"=== 各分群的原始指標平均值 ===\")\n",
        "display(cluster_summary)\n",
        "\n",
        "# 3. 視覺化分群結果 (以 R 與 M 欄位為例)\n",
